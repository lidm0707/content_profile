# --- UI (build-time, read by ui_wasm/build.rs via dotenvy) ---
# Base URL of the content_backend HTTP API. Empty = same-origin (behind nginx).
BACKEND_API_URL=

# --- content_backend (runtime env) ---
# Address the backend listens on (default 0.0.0.0:8080).
HTTP_ADDR=0.0.0.0:8080

# Backend storage mode: pg | pg_sync | supabase
# - pg:        local Postgres only
# - pg_sync:   local Postgres + push/pull sync with Supabase
# - supabase:  Supabase only
BACKEND_MODE=pg

# Required. Postgres connection string (sqlx).
DATABASE_URL=postgres://user:password@localhost:5432/content_profile

# Optional. Supabase project used by pg_sync / supabase modes and
# Supabase token verification (login exchange).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Optional. Google OAuth for Drive connection. The client ID may also be
# set per user in Settings → Google; secret + redirect are env-only.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:6191/api/oauth/google/callback
GOOGLE_DRIVE_FOLDER_ID=
# --- examples/login.rs (compile-time env!) ---
# Only needed if you build the examples: cargo build --examples
# SUPABASE_URL / SUPABASE_ANON_KEY above are reused for it.
